# Voice-to-Tasks Automation - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Vikunja Configuration
# ============================================
VIKUNJA_URL=https://tasks.yourdomain.com
VIKUNJA_API_TOKEN=your_vikunja_api_token_here

# ============================================
# n8n Configuration
# ============================================
N8N_URL=https://n8n.yourdomain.com
N8N_API_KEY=your_n8n_api_key_here

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-5
OPENAI_WHISPER_MODEL=whisper-1

# ============================================
# Email Configuration (IMAP/SMTP)
# ============================================
EMAIL_ADDRESS=tasks@yourdomain.com
EMAIL_PASSWORD=your_email_password_here

# IMAP Settings
IMAP_HOST=mail.yourdomain.com
IMAP_PORT=993
IMAP_SSL=true

# SMTP Settings
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURITY=STARTTLS

# ============================================
# Open WebUI Configuration
# ============================================
OPEN_WEBUI_URL=https://ai.yourdomain.com
OPEN_WEBUI_API_KEY=your_openwebui_api_key_here

# ============================================
# RunPod Configuration (Optional)
# ============================================
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_POD_ID=your_pod_id_here
OLLAMA_BASE_URL=http://runpod_ip:11434

# ============================================
# Server Configuration
# ============================================
# n8n Server
N8N_SERVER_HOST=your.server.ip
N8N_SERVER_USER=root
N8N_SERVER_SSH_PORT=22

# Open WebUI Server  
OPENWEBUI_SERVER_HOST=your.server.ip
OPENWEBUI_SERVER_USER=root
OPENWEBUI_SERVER_SSH_PORT=22

# ============================================
# Application Settings
# ============================================
APP_NAME="Voice-to-Tasks Automation"
APP_ENV=production
APP_DEBUG=false

# Timezone
TZ=UTC

